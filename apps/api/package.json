{
  "name": "@numotion/api",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/servidor.ts",
    "start": "node --env-file-if-exists=../../.env dist/servidor.js",
    "build": "prisma generate && esbuild src/servidor.ts src/app.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --packages=external --alias:@numotion/core=../../packages/core/src",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.700.0",
    "@numotion/core": "*",
    "@prisma/client": "6.19.3",
    "cookie-parser": "1.4.7",
    "express": "4.21.2",
    "nodemailer": "^10.0.16",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "0.25.5",
    "prisma": "6.19.3",
    "tsx": "4.19.4"
  }
}
