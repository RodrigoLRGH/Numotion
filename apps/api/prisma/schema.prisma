  creado_en         DateTime          @default(now()) @db.Timestamptz(6)
  alumno            alumno            @relation(fields: [alumno_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  asignacion_alumno asignacion_alumno @relation(fields: [asignacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([asignacion_id, creado_en], map: "ajuste_asignacion_idx")
