/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model alumno {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grupo_id                  String                      @db.Uuid
  nombre                    String
  apellidos                 String                      @default("")
  avatar                    String
  pin_hash                  String?
  intentos_fallidos         Int                         @default(0)
  bloqueado_hasta           DateTime?                   @db.Timestamptz(6)
  intereses                 String[]                    @default([])
  activo                    Boolean                     @default(true)
  creado_en                 DateTime                    @default(now()) @db.Timestamptz(6)
  ajuste_dificultad         ajuste_dificultad[]
  grupo                     grupo                       @relation(fields: [grupo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  alumno_insignia           alumno_insignia[]
  asignacion_alumno         asignacion_alumno[]
  consentimiento_tutor      consentimiento_tutor[]
  diagnostico_mat_respuesta diagnostico_mat_respuesta[]
  diagnostico_mat_resultado diagnostico_mat_resultado[]
  evento_emocional          evento_emocional[]
  intento_ejercicio         intento_ejercicio[]
  nota_docente              nota_docente[]
  panas_resultado           panas_resultado[]
  perfil_gamificacion       perfil_gamificacion?
  practica_libre            practica_libre[]
  racha_alumno              racha_alumno?
  resultado_academico       resultado_academico[]
  retroalimentacion         retroalimentacion[]
  sesion_alumno             sesion_alumno[]
  uso_rekognition           uso_rekognition[]

  @@unique([grupo_id, avatar])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model alumno_insignia {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
