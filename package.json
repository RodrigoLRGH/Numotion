{
  "name": "numotion",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @numotion/api\" \"npm run dev -w @numotion/web\"",
    "build": "npm run build -w @numotion/web && npm run build -w @numotion/api",
    "typecheck": "tsc -p packages/core && tsc -p apps/api && tsc -p apps/web && tsc -p tests",
    "test": "vitest run --project unidad --project componentes",
    "test:watch": "vitest --project unidad --project componentes",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "db:migrar": "node --env-file-if-exists=.env scripts/migrar.mjs",
    "db:purgar": "node --env-file-if-exists=.env scripts/purgar.mjs",
    "admin:crear": "node --env-file-if-exists=.env scripts/crear-admin.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/migrar.mjs --seed",
    "correo:probar": "node --env-file-if-exists=.env scripts/probar-correo.mjs",
    "db:pull": "node --env-file-if-exists=.env scripts/prisma-pull.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/supertest": "6.0.3",
    "concurrently": "9.1.2",
    "jsdom": "^26.1.0",
    "postgres": "^3.4.5",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "supertest": "7.1.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
