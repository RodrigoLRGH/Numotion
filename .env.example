# Conexión de la app: rol sin BYPASSRLS (ADR-003, ADR-010)
DATABASE_URL=postgres://numotion_app:numotion_app@localhost:5433/numotion
# Solo migraciones y seed: rol dueño del esquema
DATABASE_OWNER_URL=postgres://numotion_owner:numotion_owner@localhost:5433/numotion
# Contraseña que `npm run db:migrar` asigna al rol numotion_app
NUMOTION_APP_PASSWORD=numotion_app
# Base para pruebas de BD (se recrea en cada corrida)
TEST_DATABASE_OWNER_URL=postgres://numotion_owner:numotion_owner@localhost:5433/numotion_test

APP_TIMEZONE=America/Tijuana
# Detección emocional (EXP-05): rekognition | simulado | desactivado (en producción, desactivado si no se define)
EMOTION_PROVIDER=simulado
# Topes por alumno (RC-04); si no se definen se usan los de config_adaptativa (5 s y 400/día)
# REKOGNITION_MIN_INTERVAL_SECONDS=5
# REKOGNITION_DAILY_CAP_PER_ALUMNO=400
AWS_REGION=us-east-1

# Correo: smtp (producción, Google Workspace) | archivo (desarrollo/E2E) | memoria (pruebas)
CORREO_PROVEEDOR=archivo
CORREO_DIR=tmp/correos
# Google Workspace (CORREO_PROVEEDOR=smtp). Verificar con: npm run correo:probar -- tu@correo.mx
# SMTP_PASSWORD es una CONTRASEÑA DE APLICACIÓN (requiere verificación en dos pasos), nunca la contraseña normal.
# MAIL_FROM debe ser la misma cuenta o un alias configurado en Gmail como "Enviar como".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USUARIO=
SMTP_PASSWORD=
MAIL_FROM="Numotion <no-responder@tu-escuela.edu.mx>"

# OpenAI (opcional, ADR-007): problemas con historia según los intereses del alumno. Sin clave o
# con OPENAI_ENABLED=false se usa solo el catálogo. OPENAI_MODE=mock genera historias sin red (CI/E2E).
# La clave va SOLO aquí o en las variables de entorno de Vercel, nunca en el código.
OPENAI_ENABLED=false
OPENAI_MODE=real
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Tope de gasto estimado por mes (USD); además pon un límite en la cuenta de OpenAI
OPENAI_MONTHLY_BUDGET_USD=5
OPENAI_TIMEOUT_MS=20000
# Precio del modelo en USD por millón de tokens (entrada / salida), para el presupuesto
OPENAI_PRECIO_ENTRADA_1M=0.15
OPENAI_PRECIO_SALIDA_1M=0.60

# API local y origen público para los enlaces de los correos
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Producción con pooler (Neon/Supabase): DATABASE_URL=postgres://numotion_app:…@…-pooler…/numotion?pgbouncer=true&connection_limit=1
