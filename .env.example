# Conexión de la app: rol sin BYPASSRLS (ADR-003, ADR-010)
DATABASE_URL=postgres://numotion_app:numotion_app@localhost:5433/numotion
# Solo migraciones y seed: rol dueño del esquema
DATABASE_OWNER_URL=postgres://numotion_owner:numotion_owner@localhost:5433/numotion
# Contraseña que `npm run db:migrar` asigna al rol numotion_app
NUMOTION_APP_PASSWORD=numotion_app
# Base para pruebas de BD (se recrea en cada corrida)
TEST_DATABASE_OWNER_URL=postgres://numotion_owner:numotion_owner@localhost:5433/numotion_test

APP_TIMEZONE=America/Tijuana
EMOTION_PROVIDER=simulado
AWS_REGION=us-east-1

# Correo: smtp (producción, Google Workspace) | archivo (desarrollo/E2E) | memoria (pruebas)
CORREO_PROVEEDOR=archivo
CORREO_DIR=tmp/correos
# Google Workspace (CORREO_PROVEEDOR=smtp). Verificar con: npm run correo:probar -- tu@correo.mx
# SMTP_PASSWORD es una CONTRASEÑA DE APLICACIÓN (requiere verificación en dos pasos), nunca la contraseña normal.
# MAIL_FROM debe ser la misma cuenta o un alias configurado en Gmail como "Enviar como".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USUARIO=
SMTP_PASSWORD=
MAIL_FROM="Numotion <no-responder@tu-escuela.edu.mx>"

# API local y origen público para los enlaces de los correos
PORT=3000
WEB_ORIGIN=http://localhost:5173
