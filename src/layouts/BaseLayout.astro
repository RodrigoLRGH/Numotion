---
// Load global styles (including Tailwind)
import "../styles/global.css";

// Load core components
import Head from "../components/core/Head.astro";
import Header from "../components/core/Header.astro";
import Footer from "../components/core/Footer.astro";

interface Props {
    titulo?: string;
    /** Ancho máximo del contenido principal */
    ancho?: "normal" | "amplio";
    /** El módulo alumno usa tipografía base de 20 px y objetivos de 48 px (04-arquitectura §7) */
    modulo?: "alumno" | "docente" | "publico";
}

const { titulo, ancho = "normal", modulo = "publico" }: Props = Astro.props;
---

<!doctype html>
<html lang="es-MX">
    <Head titulo={titulo} />
    <!-- With these Tailwind classes, the footer is always stuck to the bottom -->
    <body class:list={["flex min-h-screen flex-col bg-fondo font-sans", modulo === "alumno" && "text-xl"]} data-modulo={modulo}>
        <Header />
        <main id="contenido" class:list={["mx-auto w-full flex-grow px-4 py-6", ancho === "amplio" ? "max-w-6xl" : "max-w-4xl"]}>
            <slot />
        </main>
        <Footer />
    </body>
</html>
