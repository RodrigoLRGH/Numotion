---
// Navegación según el rol de la sesión (módulo docente / módulo alumno)
const usuario = Astro.locals.usuario;
const ruta = Astro.url.pathname;

const enlaces =
    usuario?.rol === "docente"
        ? [
              { href: "/docente", texto: "Panel" },
              { href: "/docente/grupos", texto: "Grupos" },
              { href: "/docente/actividades", texto: "Actividades" },
              { href: "/docente/historial", texto: "Historial" },
              { href: "/docente/reportes", texto: "Reportes" },
          ]
        : usuario?.rol === "alumno"
          ? [
                { href: "/alumno", texto: "🏠 Mi panel" },
                { href: "/alumno/perfil", texto: "🦸 Mi perfil" },
            ]
          : [];

const activo = (href: string) => (href === "/docente" || href === "/alumno" ? ruta === href : ruta.startsWith(href));
---

<!-- Only meant to be used for BaseLayout.astro -->
<header class="bg-marca text-white">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:rounded focus:bg-white focus:px-3 focus:py-1 focus:text-marca">
        Saltar al contenido
    </a>
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3">
        <a href={usuario ? (usuario.rol === "docente" ? "/docente" : "/alumno") : "/"} class="text-2xl font-extrabold tracking-tight">
            FEEL-FACE
        </a>
        {
            usuario && (
                <nav aria-label="Principal" class="flex flex-wrap items-center gap-1">
                    {enlaces.map((e) => (
                        <a
                            href={e.href}
                            aria-current={activo(e.href) ? "page" : undefined}
                            class:list={[
                                "rounded-lg px-3 py-2 font-semibold hover:bg-white/15",
                                activo(e.href) && "bg-white/20 underline underline-offset-4",
                            ]}
                        >
                            {e.texto}
                        </a>
                    ))}
                    <span class="mx-2 hidden text-sm opacity-90 sm:inline">{usuario.nombre}</span>
                    <form method="post" action="/api/auth/logout">
                        <button type="submit" class="cursor-pointer rounded-lg border border-white/60 px-3 py-1.5 text-sm font-bold hover:bg-white/15">
                            Salir
                        </button>
                    </form>
                </nav>
            )
        }
    </div>
</header>
