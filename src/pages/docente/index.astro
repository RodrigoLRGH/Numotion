---
// Panel docente PROVISIONAL: el resumen previo del grupo (D1) llega con EXP-07.
import BaseLayout from "../../layouts/BaseLayout.astro";

const nombre = Astro.locals.usuario?.nombre ?? "";
---

<BaseLayout titulo="Panel" modulo="docente" ancho="amplio">
    <section class="tarjeta">
        <h1 class="text-2xl font-extrabold">Hola, {nombre}</h1>
        <p class="mt-2 text-tinta-suave">El resumen de cómo llega tu grupo cada día aparecerá aquí.</p>
        <a href="/docente/grupos" class="boton mt-4">Ver mis grupos y alumnos</a>
    </section>
</BaseLayout>
