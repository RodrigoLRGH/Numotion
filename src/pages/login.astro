---
import BaseLayout from "../layouts/BaseLayout.astro";
import FormularioAcceso from "../modules/docente/componentes/FormularioAcceso";

const siguiente = Astro.url.searchParams.get("siguiente") ?? undefined;
---

<BaseLayout titulo="Entrar como docente" modulo="docente">
    <FormularioAcceso client:load modo="login" siguiente={siguiente} />
    <p class="mt-6 text-center">¿Eres alumno? <a href="/entrar" class="font-bold text-marca underline">Entra aquí</a></p>
</BaseLayout>
