---
// Panel del alumno. El middleware solo deja llegar aquí con los diagnósticos del día completos.
// Racha, puntos, insignias y frase motivacional llegan con EXP-06.
import BaseLayout from "../../layouts/BaseLayout.astro";
import MisActividades from "../../modules/alumno/componentes/MisActividades";

const nombre = Astro.locals.usuario?.nombre.split(" ")[0] ?? "";
---

<BaseLayout titulo="Mi panel" modulo="alumno">
    <h1 class="mb-6 text-3xl font-extrabold">¡Hola, {nombre}! <span aria-hidden="true">👋</span></h1>
    <MisActividades client:load />
</BaseLayout>
