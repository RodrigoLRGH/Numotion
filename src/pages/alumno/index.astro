---
// Panel del alumno PROVISIONAL: el middleware solo deja llegar aquí con los diagnósticos del día
// completos. Racha, puntos, insignias y actividades llegan con EXP-04 y EXP-06.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BotonAudio } from "../../modules/shared/ui/BotonAudio";

const nombre = Astro.locals.usuario?.nombre.split(" ")[0] ?? "";
const mensaje = `¡Hola ${nombre}! Ya terminaste las preguntas de hoy. ¡Muy bien!`;
---

<BaseLayout titulo="Mi panel" modulo="alumno">
    <section class="tarjeta mx-auto max-w-2xl text-center">
        <p aria-hidden="true" class="text-6xl">🎉</p>
        <div class="mt-3 flex items-center justify-center gap-3">
            <h1 class="text-3xl font-extrabold">{mensaje}</h1>
            <BotonAudio client:load texto={mensaje} />
        </div>
        <p class="mt-4 text-tinta-suave">Muy pronto aquí verás tus actividades y tus juegos.</p>
    </section>
</BaseLayout>
